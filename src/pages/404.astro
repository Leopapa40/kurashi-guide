---
/**
 * 404.astro — カスタムエラーページ
 * Cloudflare Pages が 404 時に自動的にこのページを表示する
 */
import '../styles/global.css';
import '../styles/dark.css';
import '../styles/components.css';
import { MUNICIPALITY_THEME } from '../lib/categories';

const cityMeta = MUNICIPALITY_THEME['ota-city'];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ページが見つかりません | くらしガイド</title>
  <meta name="description" content="お探しのページは見つかりませんでした。" />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg-main,#f8fafc);color:var(--text-main,#1e293b);min-height:100vh;display:flex;flex-direction:column;">

  <header class="header-light">
    <div class="header-light__inner">
      <a class="logo" href="/ja/">太田市 くらしガイド</a>
    </div>
  </header>

  <main style="flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1rem;">
    <div style="text-align:center;max-width:480px;">
      <div style="font-size:5rem;margin-bottom:1rem;line-height:1;">🔍</div>
      <h1 style="font-size:1.75rem;font-weight:800;margin:0 0 1rem;letter-spacing:-.02em;">
        ページが見つかりません
      </h1>
      <p style="color:#64748b;margin:0 0 .5rem;line-height:1.7;font-size:.95rem;">
        お探しのページは移動または削除された可能性があります。
      </p>
      <p style="color:#64748b;margin:0 0 2rem;line-height:1.7;font-size:.95rem;">
        URLをご確認いただくか、トップページからお探しください。
      </p>
      <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
        <a href="/ja/" style="display:inline-flex;align-items:center;gap:.375rem;padding:.75rem 1.5rem;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;border-radius:.625rem;text-decoration:none;font-weight:600;font-size:.95rem;box-shadow:0 2px 8px rgba(59,130,246,.3);transition:transform .15s,box-shadow .15s;">
          🏠 トップページへ
        </a>
        <a href="/en/" style="display:inline-flex;align-items:center;gap:.375rem;padding:.75rem 1.5rem;background:transparent;color:#3b82f6;border:1.5px solid #3b82f6;border-radius:.625rem;text-decoration:none;font-weight:600;font-size:.95rem;transition:background .15s;">
          🌐 English
        </a>
        <a href="/pt/" style="display:inline-flex;align-items:center;gap:.375rem;padding:.75rem 1.5rem;background:transparent;color:#3b82f6;border:1.5px solid #3b82f6;border-radius:.625rem;text-decoration:none;font-weight:600;font-size:.95rem;transition:background .15s;">
          🌐 Português
        </a>
      </div>
    </div>
  </main>

  <footer class="footer-light">
    <div style="max-width:960px;margin:0 auto;padding:0 1.25rem">
      <p>太田市 くらしガイド — AIが公式情報をわかりやすく要約しています</p>
    </div>
  </footer>

</body>
</html>
