---
/**
 * [layer].astro — マップ個別レイヤーページ
 * URL: /ja/ota-city/map/wifi/ など
 * Phase 2A-1: wifi レイヤーのみ対応。他レイヤーは Phase 2A-2 で追加。
 */
import '../../../../styles/global.css';
import '../../../../styles/dark.css';
import '../../../../styles/components.css';
import LightLayout from '../../../../layouts/LightLayout.astro';
import layerConfig from '../../../../data/layer_config.json';

export function getStaticPaths() {
  const langs = ['ja', 'en', 'pt'] as const;
  const municipalities = ['ota-city'] as const;
  const layers = ['wifi', 'medical', 'pharmacy', 'mobile_shop', 'dental'] as const;

  return langs.flatMap(lang =>
    municipalities.flatMap(municipality =>
      layers.map(layer => ({
        params: { lang, municipality, layer },
      }))
    )
  );
}

// サポートするレイヤー（Phase 2A-2）
const SUPPORTED_LAYERS = ['wifi', 'medical', 'pharmacy', 'mobile_shop', 'dental'] as const;
type LayerKey = typeof SUPPORTED_LAYERS[number];

const { lang, municipality, layer } = Astro.params as {
  lang: 'ja' | 'en' | 'pt';
  municipality: string;
  layer: LayerKey;
};

// layer_config.json から現在のレイヤーの設定を取得
const config = (layerConfig as any)[layer];
const layerTitle = config?.title?.[lang] ?? config?.title?.['ja'] ?? layer;
const filterConfig = config?.filter_config ?? null;

// 多言語ラベル
const labels = {
  pageTitle: {
    ja: `${layerTitle}マップ`,
    en: `${layerTitle} Map`,
    pt: `Mapa de ${layerTitle}`,
  },
  description: {
    ja: `太田市の${layerTitle}をマップで探す`,
    en: `Find ${layerTitle} in Ota City on the map`,
    pt: `Encontre ${layerTitle} em Ota City no mapa`,
  },
  loading: {
    ja: 'マップを読み込み中...',
    en: 'Loading map...',
    pt: 'Carregando mapa...',
  },
  noResults: {
    ja: 'スポットが見つかりませんでした',
    en: 'No spots found',
    pt: 'Nenhum ponto encontrado',
  },
  filterAll: { ja: 'すべて', en: 'All', pt: 'Todos' },
  specialty: { ja: '診療科', en: 'Specialty', pt: 'Especialidade' },
  language: { ja: '外国語対応', en: 'Language', pt: 'Idiomas' },
  type: { ja: '種別', en: 'Type', pt: 'Tipo' },
  listTitle: { ja: '施設一覧', en: 'Facility List', pt: 'Lista de Instalações' },
  noLangSupport: { ja: '外国語対応なし', en: 'No language support', pt: 'Sem suporte de idiomas' },
  openInGmaps: { ja: 'Google Maps', en: 'Google Maps', pt: 'Google Maps' },
};

const L = (key: keyof typeof labels) => (labels[key] as any)[lang] ?? (labels[key] as any)['ja'];

// GeoJSON の公開 URL（Astro ビルド後に /public から配信される）
// municipality は 'ota-city' だが、GeoJSON ファイル名は 'ota_wifi.geojson'（ハイフンなし）
const citySlug = municipality.replace('-city', '');
const geojsonUrl = `/data/maps/${citySlug}_${layer}.geojson`;

// 太田市の中心座標
const CITY_CONFIG: Record<string, { lng: number; lat: number; zoom: number }> = {
  'ota-city': { lng: 139.3761, lat: 36.2920, zoom: 13 },
};
const cityCenter = CITY_CONFIG[municipality] ?? { lng: 139.3761, lat: 36.2920, zoom: 13 };

// ベースマップスタイル（Protomaps ベクトルタイル + 多言語対応）
// ※ スタイルはクライアントサイドで @protomaps/basemaps から動的生成するため、
//    ここではタイルソースURL と言語情報のみ渡す
const PMTILES_URL = 'pmtiles://https://tiles.kurashiguide.org/ota_city.pmtiles';
---

<LightLayout
  title={L('pageTitle')}
  description={L('description')}
  lang={lang}
  municipality={municipality}
>
  <div class="map-page">
    <h1 class="map-page__title">
      <span class="map-page__icon">
        {layer === 'wifi' ? '📶' : layer === 'medical' ? '🏥' : layer === 'pharmacy' ? '💊' : layer === 'dental' ? '🦷' : '📱'}
      </span>
      {L('pageTitle')}
    </h1>

    <!-- マップコンテナ -->
    <div id="map-container" class="map-container" role="application" aria-label={L('pageTitle')}>
      <div id="map-loading" class="map-loading">{L('loading')}</div>
      <div id="map" style="width:100%;height:100%;"></div>
    </div>

    <!-- スポット件数表示 -->
    <p id="spot-count" class="map-spot-count" aria-live="polite"></p>

    <!-- フィルターバー（filter_config があるレイヤーのみ表示） -->
    <div id="filter-bar" class="filter-bar" style={filterConfig ? '' : 'display:none'}>
      <!-- フィルターはクライアントサイド JS で動的生成 -->
    </div>

    <!-- 施設一覧 -->
    <h2 class="list-title">{L('listTitle')}</h2>
    <div id="spot-list" class="spot-list">
      <!-- クライアントサイド JS で動的生成 -->
    </div>
  </div>

  <!-- MapLibre GL JS をクライアントサイドで読み込む -->
  <script define:vars={{ geojsonUrl, cityCenter, lang, PMTILES_URL, layer, filterConfig }}>
    // Astro の define:vars で渡された変数をグローバルに保持
    window.__MAP_CONFIG__ = { geojsonUrl, cityCenter, lang, PMTILES_URL, layer, filterConfig };
  </script>
  <script>
    // Astro はクライアント <script> 内の npm import を自動バンドルする
    import maplibregl from 'maplibre-gl';
    import 'maplibre-gl/dist/maplibre-gl.css';
    import { Protocol } from 'pmtiles';
    import { layers, namedFlavor } from '@protomaps/basemaps';

    // PMTiles プロトコル登録
    const protocol = new Protocol();
    maplibregl.addProtocol('pmtiles', protocol.tile);

    const { geojsonUrl, cityCenter, lang, PMTILES_URL, layer, filterConfig } = (window as any).__MAP_CONFIG__;

    // Protomaps ベクトルタイル + 多言語ラベルスタイル
    const mapStyle = {
      version: 8,
      glyphs: 'https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf',
      sprite: 'https://protomaps.github.io/basemaps-assets/sprites/v4/light',
      sources: {
        protomaps: {
          type: 'vector',
          url: PMTILES_URL,
          attribution: '<a href="https://protomaps.com">Protomaps</a> © <a href="https://openstreetmap.org">OpenStreetMap</a>',
        },
      },
      layers: layers('protomaps', namedFlavor('light'), { lang: lang }),
    };

    const map = new maplibregl.Map({
      container: 'map',
      style: mapStyle as any,
      center: [cityCenter.lng, cityCenter.lat],
      zoom: cityCenter.zoom,
      attributionControl: true,
    });

    map.on('load', async () => {
      // ローディング非表示
      const loading = document.getElementById('map-loading');
      if (loading) loading.style.display = 'none';

      // GeoJSON フェッチ
      let geojson;
      try {
        const res = await fetch(geojsonUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        geojson = await res.json();
      } catch (e) {
        console.error('GeoJSON fetch failed:', e);
        return;
      }

      const features = geojson.features ?? [];
      let allFeatures = features;

      function updateCount(count: number) {
        const countEl = document.getElementById('spot-count');
        if (!countEl) return;
        const label = lang === 'ja' ? `${count} 件のスポットを表示中` :
                      lang === 'en' ? `Showing ${count} spots` :
                      `Exibindo ${count} pontos`;
        countEl.textContent = label;
      }

      function createFilterGroup(label: string, options: any, filterKey: string) {
        const wrapper = document.createElement('div');
        wrapper.className = 'filter-group';
        
        const labelEl = document.createElement('label');
        labelEl.className = 'filter-group__label';
        labelEl.textContent = label;
        wrapper.appendChild(labelEl);

        const select = document.createElement('select');
        select.className = 'filter-group__select';
        select.dataset.filterKey = filterKey;
        
        Object.entries(options).forEach(([value, labelsOption]) => {
          const lObj = labelsOption as any;
          const opt = document.createElement('option');
          opt.value = value;
          opt.textContent = lObj[lang] ?? lObj['ja'] ?? value;
          select.appendChild(opt);
        });

        select.addEventListener('change', applyFilters);
        wrapper.appendChild(select);
        return wrapper;
      }

      function buildFilterBar() {
        const bar = document.getElementById('filter-bar');
        if (!bar || !filterConfig) return;
        bar.innerHTML = '';

        // 症状フィルター
        if (filterConfig.symptom_filter) {
          const symptomConfig = filterConfig.symptom_filter;
          const labelText = symptomConfig.label?.[lang] ?? 'What are your symptoms?';
          
          const labelEl = document.createElement('p');
          labelEl.className = 'symptom-label';
          labelEl.textContent = '🔍 ' + labelText;
          bar.appendChild(labelEl);

          const gridEl = document.createElement('div');
          gridEl.className = 'symptom-grid';
          
          const allBtn = document.createElement('button');
          allBtn.className = 'symptom-btn symptom-btn--active';
          allBtn.dataset.symptom = 'all';
          allBtn.innerHTML = `
            <span class="symptom-btn__icon">🏥</span>
            <span class="symptom-btn__text">${lang === 'ja' ? 'すべて' : lang === 'en' ? 'All' : 'Todos'}</span>
          `;
          allBtn.addEventListener('click', () => {
            document.querySelectorAll('.symptom-btn').forEach(b => b.classList.remove('symptom-btn--active'));
            allBtn.classList.add('symptom-btn--active');
            applyFilters();
          });
          gridEl.appendChild(allBtn);

          symptomConfig.categories.forEach((c: any) => {
            const btn = document.createElement('button');
            btn.className = 'symptom-btn';
            btn.dataset.symptom = c.id;
            btn.innerHTML = `
              <span class="symptom-btn__icon">${c.icon}</span>
              <span class="symptom-btn__text">${c.label?.[lang] ?? c.id}</span>
            `;
            btn.addEventListener('click', () => {
              document.querySelectorAll('.symptom-btn').forEach(b => b.classList.remove('symptom-btn--active'));
              btn.classList.add('symptom-btn--active');
              applyFilters();
            });
            gridEl.appendChild(btn);
          });
          
          bar.appendChild(gridEl);
        }

        // サブカテゴリフィルター（種別）
        if (filterConfig.subcategory) {
          const group = createFilterGroup(
            filterConfig.subcategory.label?.[lang] ?? 'Type',
            filterConfig.subcategory.options,
            'subcategory'
          );
          bar.appendChild(group);
        }

        let advancedFilter: HTMLDetailsElement | null = null;
        if (filterConfig.specialty?.dynamic || filterConfig.language) {
           advancedFilter = document.createElement('details');
           advancedFilter.className = 'advanced-filter';
           const summary = document.createElement('summary');
           summary.textContent = lang === 'ja' ? '詳しい診療科で絞る' : lang === 'en' ? 'Filter by specific specialty' : 'Filtrar por especialidade específica';
           advancedFilter.appendChild(summary);
           bar.appendChild(advancedFilter);
        }

        // 診療科フィルター（dynamic: GeoJSON から収集）
        if (filterConfig.specialty?.dynamic) {
          const allSpecs = new Set<string>();
          allFeatures.forEach((f: any) => {
            (f.properties.specialties || []).forEach((s: string) => allSpecs.add(s));
          });
          const specOptions: any = { all: { ja: 'すべて', en: 'All', pt: 'Todos' } };
          [...allSpecs].sort((a, b) => a.localeCompare(b, 'ja')).forEach(s => {
            specOptions[s] = { ja: s, en: s, pt: s };
          });
          const group = createFilterGroup(
            filterConfig.specialty.label?.[lang] ?? 'Specialty',
            specOptions,
            'specialty'
          );
          if (advancedFilter) advancedFilter.appendChild(group);
          else bar.appendChild(group);
        }

        // 外国語フィルター
        if (filterConfig.language) {
          const hasLangData = allFeatures.some((f: any) => (f.properties.languages || []).length > 0);
          if (hasLangData) {
            const group = createFilterGroup(
              filterConfig.language.label?.[lang] ?? 'Language',
              filterConfig.language.options,
              'language'
            );
            if (advancedFilter) advancedFilter.appendChild(group);
            else bar.appendChild(group);
          }
        }
      }

      function renderList(filteredFeatures: any[]) {
        const listEl = document.getElementById('spot-list');
        if (!listEl) return;

        if (filteredFeatures.length === 0) {
          listEl.innerHTML = `<p class="spot-list__empty">${
            lang === 'ja' ? 'スポットが見つかりませんでした' :
            lang === 'en' ? 'No spots found' : 'Nenhum ponto encontrado'
          }</p>`;
          return;
        }

        const PAGE_SIZE = 20;
        let showCount = PAGE_SIZE;

        function render() {
          const visible = filteredFeatures.slice(0, showCount);
          const remaining = filteredFeatures.length - showCount;

          listEl.innerHTML = visible.map(f => {
            const p = f.properties;
            const name = p[`name_${lang}`] ?? p.name_ja ?? p.name ?? '';
            const addr = p.address ?? '';
            const phone = p.phone ?? '';
            const allSpecs = p.specialties || [];
            const MAX_SPECS = 5;
            const specs = allSpecs.length > MAX_SPECS
              ? allSpecs.slice(0, MAX_SPECS).join('、') + (lang === 'ja' ? `…他${allSpecs.length - MAX_SPECS}科` : lang === 'en' ? `…+${allSpecs.length - MAX_SPECS} more` : `…+${allSpecs.length - MAX_SPECS} mais`)
              : allSpecs.join('、');
            const langs = (p.languages || []);
            const [lng, lat] = f.geometry.coordinates;
            const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;

            const langBadges = langs.length > 0
              ? langs.map((l: string) => `<span class="lang-badge lang-badge--${l}">${l.toUpperCase()}</span>`).join('')
              : '';

            return `
              <div class="spot-card" data-lng="${lng}" data-lat="${lat}">
                <div class="spot-card__header">
                  <strong class="spot-card__name">${name}</strong>
                  ${langBadges ? `<div class="spot-card__langs">${langBadges}</div>` : ''}
                </div>
                ${specs ? `<p class="spot-card__specs">${specs}</p>` : ''}
                ${addr ? `<p class="spot-card__addr">📍 ${addr}</p>` : ''}
                <div class="spot-card__footer">
                  ${phone ? `<a href="tel:${phone}" class="spot-card__phone">📞 ${phone}</a>` : ''}
                  <a href="${gmapsUrl}" target="_blank" rel="noopener" class="spot-card__gmaps">🗺 Google Maps</a>
                </div>
              </div>
            `;
          }).join('');

          // 「もっと見る」ボタン
          if (remaining > 0) {
            const btn = document.createElement('button');
            btn.className = 'spot-list__load-more';
            btn.textContent = lang === 'ja' ? `さらに${Math.min(remaining, PAGE_SIZE)}件を表示`
                             : lang === 'en' ? `Show ${Math.min(remaining, PAGE_SIZE)} more`
                             : `Mostrar mais ${Math.min(remaining, PAGE_SIZE)}`;
            btn.addEventListener('click', () => {
              showCount += PAGE_SIZE;
              render();
            });
            listEl.appendChild(btn);
          }

          // カードクリック → マップをパンする
          listEl.querySelectorAll('.spot-card').forEach(card => {
            card.addEventListener('click', (e) => {
              if ((e.target as HTMLElement).closest('a')) return; // リンククリックは除外
              const lng = parseFloat((card as HTMLElement).dataset.lng!);
              const lat = parseFloat((card as HTMLElement).dataset.lat!);
              map.flyTo({ center: [lng, lat], zoom: 16 });
            });
          });
        }

        render();
      }

      function applyFilters() {
        const selects = document.querySelectorAll('.filter-group__select') as NodeListOf<HTMLSelectElement>;
        const filters: Record<string, string> = {};
        selects.forEach(s => { filters[s.dataset.filterKey!] = s.value; });

        const activeSymptomBtn = document.querySelector('.symptom-btn--active') as HTMLElement;
        const activeSymptom = activeSymptomBtn?.dataset.symptom ?? 'all';
        let symptomSpecs: string[] | null = null;
        if (activeSymptom !== 'all' && filterConfig.symptom_filter) {
          const category = filterConfig.symptom_filter.categories.find((c: any) => c.id === activeSymptom);
          if (category) symptomSpecs = category.specialties;
        }

        const filtered = allFeatures.filter((f: any) => {
          const p = f.properties;
          
          if (symptomSpecs) {
            const featureSpecs = p.specialties || [];
            if (!featureSpecs.some((s: string) => symptomSpecs!.includes(s))) return false;
          }

          // サブカテゴリ
          if (filters.subcategory && filters.subcategory !== 'all') {
            if (p.subcategory !== filters.subcategory && p.category !== filters.subcategory) return false;
          }
          
          // 診療科
          if (filters.specialty && filters.specialty !== 'all') {
            if (!(p.specialties || []).includes(filters.specialty)) return false;
          }
          
          // 外国語
          if (filters.language && filters.language !== 'all') {
            if (!(p.languages || []).includes(filters.language)) return false;
          }
          
          return true;
        });

        // マップのソースを更新
        const source = map.getSource('spots') as maplibregl.GeoJSONSource;
        if (source) {
          source.setData({
            type: 'FeatureCollection',
            features: filtered
          });
        }

        // 件数更新
        updateCount(filtered.length);
        
        // 一覧更新
        renderList(filtered);
      }

      // 初回件数表示
      updateCount(features.length);

      const circleColor =
        layer === 'wifi'       ? '#3b82f6' :  // 青
        layer === 'medical'    ? '#ef4444' :  // 赤
        layer === 'pharmacy'   ? '#10b981' :  // 緑
        layer === 'dental'     ? '#8b5cf6' :  // 紫
        /* mobile_shop */        '#f59e0b';   // 黄

      // GeoJSON ソース追加（クラスタリング有効）
      map.addSource('spots', {
        type: 'geojson',
        data: geojson,
        cluster: true,
        clusterMaxZoom: 13,   // ズーム13以上でクラスタ解除
        clusterRadius: 50,
      });

      // クラスタ円
      map.addLayer({
        id: 'clusters',
        type: 'circle',
        source: 'spots',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': circleColor,
          'circle-opacity': 0.75,
          'circle-radius': [
            'step', ['get', 'point_count'],
            20, 10, 28, 30, 36
          ],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });

      // クラスタ件数ラベル
      map.addLayer({
        id: 'cluster-count',
        type: 'symbol',
        source: 'spots',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': '{point_count_abbreviated}',
          'text-size': 13,
          'text-font': ['Noto Sans Regular'],
        },
        paint: { 'text-color': '#ffffff' },
      });

      // 個別マーカー（クラスタでないもの）
      map.addLayer({
        id: 'spots-circle',
        type: 'circle',
        source: 'spots',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-radius': 8,
          'circle-color': circleColor,
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });

      // クラスタクリック → ズームイン
      map.on('click', 'clusters', (e) => {
        const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
        const clusterId = features[0]?.properties?.cluster_id;
        if (clusterId == null) return;
        (map.getSource('spots') as any).getClusterExpansionZoom(clusterId, (err: any, zoom: number) => {
          if (err) return;
          map.easeTo({ center: (features[0].geometry as any).coordinates, zoom });
        });
      });
      map.on('mouseenter', 'clusters', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'clusters', () => { map.getCanvas().style.cursor = ''; });

      // ポップアップ（リッチ版）
      map.on('click', 'spots-circle', (e) => {
        const feature = e.features?.[0];
        if (!feature) return;
        const props = feature.properties ?? {};
        const name = props[`name_${lang}`] ?? props.name_ja ?? props.name ?? '（名称不明）';
        const address = props.address ?? '';
        const phone   = props.phone ?? '';
        const lng = (feature.geometry as any).coordinates[0];
        const lat = (feature.geometry as any).coordinates[1];
        const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;

        const gmapsLabel = lang === 'ja' ? 'Google Maps で開く'
                         : lang === 'en' ? 'Open in Google Maps'
                         : 'Abrir no Google Maps';

        let html = `<div class="map-popup">`;
        html += `<strong class="map-popup__name">${name}</strong>`;
        if (address) html += `<p class="map-popup__address">📍 ${address}</p>`;
        if (phone)   html += `<p class="map-popup__phone">📞 <a href="tel:${phone}">${phone}</a></p>`;
        html += `<a class="map-popup__gmaps" href="${gmapsUrl}" target="_blank" rel="noopener">🗺 ${gmapsLabel}</a>`;
        html += `</div>`;

        new maplibregl.Popup({ maxWidth: '260px' })
          .setLngLat(e.lngLat)
          .setHTML(html)
          .addTo(map);
      });

      // カーソル変更
      map.on('mouseenter', 'spots-circle', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'spots-circle', () => { map.getCanvas().style.cursor = ''; });

      // 初回表示
      buildFilterBar();
      renderList(allFeatures);
    });

    // タイル読み込みエラー検知（OSM ブロック等）
    let tileErrorReported = false;
    map.on('error', (e) => {
      const status = e.error?.status;
      if (status === 429 || status === 403 || status === 0) {
        // ユーザーにメッセージ表示
        const loadingEl = document.getElementById('map-loading');
        if (loadingEl) {
          loadingEl.textContent = lang === 'ja'
            ? '地図の読み込みに問題があります。しばらくしてから再度お試しください。'
            : lang === 'en'
            ? 'Map loading issue. Please try again later.'
            : 'Problema ao carregar o mapa. Tente novamente mais tarde.';
          loadingEl.style.display = 'flex';
        }
        // GA4 に1回だけ送信（連打防止）
        if (!tileErrorReported && typeof gtag === 'function') {
          gtag('event', 'map_tile_error', {
            error_status: status,
            layer: layer,
          });
          tileErrorReported = true;
        }
      }
    });
  </script>

  <!-- スタイル（このページ専用） -->
  <style>
    .map-page {
      padding: 1rem 0;
    }
    .map-page__title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: var(--text-xl, 1.25rem);
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--text-primary, #1a1a2e);
    }
    .map-page__icon {
      font-size: 1.5rem;
    }
    .map-container {
      position: relative;
      width: 100%;
      height: 60vh;
      min-height: 400px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border, #e2e8f0);
      background: #f0f4f8;
    }
