---
/**
 * [layer].astro — マップ個別レイヤーページ
 * URL: /ja/ota-city/map/wifi/ など
 * Phase 2A-1: wifi レイヤーのみ対応。他レイヤーは Phase 2A-2 で追加。
 */
import '../../../../styles/global.css';
import '../../../../styles/dark.css';
import '../../../../styles/components.css';
import LightLayout from '../../../../layouts/LightLayout.astro';
import layerConfig from '../../../../data/layer_config.json';

export function getStaticPaths() {
  const langs = ['ja', 'en', 'pt'] as const;
  const municipalities = ['ota-city'] as const;
  // サポートするレイヤー（Phase 2A-1 は wifi のみ）
  const layers = ['wifi'] as const;

  return langs.flatMap(lang =>
    municipalities.flatMap(municipality =>
      layers.map(layer => ({
        params: { lang, municipality, layer },
      }))
    )
  );
}

// サポートするレイヤー（Phase 2A-1 は wifi のみ）
const SUPPORTED_LAYERS = ['wifi'] as const;
type LayerKey = typeof SUPPORTED_LAYERS[number];

const { lang, municipality, layer } = Astro.params as {
  lang: 'ja' | 'en' | 'pt';
  municipality: string;
  layer: LayerKey;
};

// layer_config.json から現在のレイヤーの設定を取得
const config = (layerConfig as any)[layer];
const layerTitle = config?.title?.[lang] ?? config?.title?.['ja'] ?? layer;

// 多言語ラベル
const labels = {
  pageTitle: {
    ja: `${layerTitle}マップ`,
    en: `${layerTitle} Map`,
    pt: `Mapa de ${layerTitle}`,
  },
  description: {
    ja: `太田市の${layerTitle}をマップで探す`,
    en: `Find ${layerTitle} in Ota City on the map`,
    pt: `Encontre ${layerTitle} em Ota City no mapa`,
  },
  loading: {
    ja: 'マップを読み込み中...',
    en: 'Loading map...',
    pt: 'Carregando mapa...',
  },
  noResults: {
    ja: 'スポットが見つかりませんでした',
    en: 'No spots found',
    pt: 'Nenhum ponto encontrado',
  },
};

const L = (key: keyof typeof labels) => (labels[key] as any)[lang] ?? (labels[key] as any)['ja'];

// GeoJSON の公開 URL（Astro ビルド後に /public から配信される）
// municipality は 'ota-city' だが、GeoJSON ファイル名は 'ota_wifi.geojson'（ハイフンなし）
const citySlug = municipality.replace('-city', '');
const geojsonUrl = `/data/maps/${citySlug}_${layer}.geojson`;

// 太田市の中心座標
const CITY_CONFIG: Record<string, { lng: number; lat: number; zoom: number }> = {
  'ota-city': { lng: 139.3761, lat: 36.2920, zoom: 13 },
};
const cityCenter = CITY_CONFIG[municipality] ?? { lng: 139.3761, lat: 36.2920, zoom: 13 };

// ベースマップスタイル（ProtomapsデモURLが404のため一時的にOSM標準ラスターを使用）
const MAP_STYLE = {
  version: 8,
  sources: {
    osm: {
      type: 'raster',
      tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
      tileSize: 256,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }
  },
  layers: [
    {
      id: 'osm',
      type: 'raster',
      source: 'osm'
    }
  ]
};
---

<LightLayout
  title={L('pageTitle')}
  description={L('description')}
  lang={lang}
  municipality={municipality}
>
  <div class="map-page">
    <h1 class="map-page__title">
      <span class="map-page__icon">{config?.icon === 'wifi' ? '📶' : config?.icon === 'medical' ? '🏥' : config?.icon === 'pharmacy' ? '💊' : '📱'}</span>
      {L('pageTitle')}
    </h1>

    <!-- マップコンテナ -->
    <div id="map-container" class="map-container" role="application" aria-label={L('pageTitle')}>
      <div id="map-loading" class="map-loading">{L('loading')}</div>
      <div id="map" style="width:100%;height:100%;"></div>
    </div>

    <!-- スポット件数表示 -->
    <p id="spot-count" class="map-spot-count" aria-live="polite"></p>
  </div>

  <!-- MapLibre GL JS をクライアントサイドで読み込む -->
  <script define:vars={{ geojsonUrl, cityCenter, lang, MAP_STYLE }}>
    // Astro の define:vars で渡された変数をグローバルに保持
    window.__MAP_CONFIG__ = { geojsonUrl, cityCenter, lang, MAP_STYLE };
  </script>
  <script>
    // Astro はクライアント <script> 内の npm import を自動バンドルする
    import maplibregl from 'maplibre-gl';
    import 'maplibre-gl/dist/maplibre-gl.css';

    const { geojsonUrl, cityCenter, lang, MAP_STYLE } = (window as any).__MAP_CONFIG__;

    const map = new maplibregl.Map({
      container: 'map',
      style: MAP_STYLE,
      center: [cityCenter.lng, cityCenter.lat],
      zoom: cityCenter.zoom,
      attributionControl: true,
    });

    map.on('load', async () => {
      // ローディング非表示
      const loading = document.getElementById('map-loading');
      if (loading) loading.style.display = 'none';

      // GeoJSON フェッチ
      let geojson;
      try {
        const res = await fetch(geojsonUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        geojson = await res.json();
      } catch (e) {
        console.error('GeoJSON fetch failed:', e);
        return;
      }

      const features = geojson.features ?? [];

      // 件数表示
      const countEl = document.getElementById('spot-count');
      if (countEl) {
        const count = features.length;
        const label = lang === 'ja' ? `${count} 件のスポットを表示中` :
                      lang === 'en' ? `Showing ${count} spots` :
                      `Exibindo ${count} pontos`;
        countEl.textContent = label;
      }

      // GeoJSON ソース追加
      map.addSource('spots', { type: 'geojson', data: geojson });

      // マーカーレイヤー（円）
      map.addLayer({
        id: 'spots-circle',
        type: 'circle',
        source: 'spots',
        paint: {
          'circle-radius': 8,
          'circle-color': '#3b82f6',
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });

      // ポップアップ
      map.on('click', 'spots-circle', (e) => {
        const feature = e.features?.[0];
        if (!feature) return;
        const props = feature.properties ?? {};
        const name = props[`name_${lang}`] ?? props.name_ja ?? props.name ?? '（名称不明）';
        const address = props.address ?? '';

        new maplibregl.Popup()
          .setLngLat(e.lngLat)
          .setHTML(`<strong>${name}</strong>${address ? `<br><small>${address}</small>` : ''}`)
          .addTo(map);
      });

      // カーソル変更
      map.on('mouseenter', 'spots-circle', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'spots-circle', () => { map.getCanvas().style.cursor = ''; });
    });
  </script>

  <!-- スタイル（このページ専用） -->
  <style>
    .map-page {
      padding: 1rem 0;
    }
    .map-page__title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: var(--text-xl, 1.25rem);
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--text-primary, #1a1a2e);
    }
    .map-page__icon {
      font-size: 1.5rem;
    }
    .map-container {
      position: relative;
      width: 100%;
      height: 60vh;
      min-height: 400px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border, #e2e8f0);
      background: #f0f4f8;
    }
    .map-loading {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      color: var(--text-muted, #64748b);
      z-index: 10;
      background: #f0f4f8;
    }
    .map-spot-count {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      color: var(--text-muted, #64748b);
    }
  </style>
</LightLayout>
