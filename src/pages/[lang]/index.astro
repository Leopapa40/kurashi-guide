---
/**
 * /[lang]/ — トップページ（YouTube型サイドバーレイアウト対応済み）
 * サイドバーにカテゴリ・困りごと・ジャーニーが移動したため、
 * トップページはヒーロー + 人気記事 + 統計バナーに簡素化
 */
import { getCollection } from 'astro:content';
import LightLayout from '../../layouts/LightLayout.astro';
import { CATEGORY_META, CATEGORIES, DOMAIN_META, DOMAINS, type Category } from '../../lib/categories';
import journeyMaster from '../../data/journey_master.json';
import layerConfig from '../../data/layer_config.json';
import fs from 'node:fs';

export async function getStaticPaths() {
  return ['ja','en','pt'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'ja'|'en'|'pt' };
const allItems = await getCollection('subsidies');

const MUNICIPALITY = 'ota-city';

const recent = allItems.filter(i => i.data.status === 'active').slice(0, 6);

const journeys = (journeyMaster as any[]).filter((j: any) => j.municipality === MUNICIPALITY);

const labels = {
  eyebrow:       { ja: '群馬県 太田市 公式情報ガイド', en: 'Ota City, Gunma — Official Guide', pt: 'Guia Oficial de Ota, Gunma' },
  h1a:           { ja: '太田市での暮らしに、', en: 'Living in Ota City?', pt: 'Morando em Ota?' },
  h1b:           { ja: 'もう迷わない。', en: 'Never get lost again.', pt: 'Nunca mais se perca.' },
  sub:           { ja: '届出・補助金・子育て・引越し…\n太田市のあらゆる手続きをわかりやすく解説します。', en: 'Registrations, subsidies, parenting, moving…\nAll Ota City procedures explained clearly.', pt: 'Registros, subsídios, filhos, mudança…\nExplicamos todos os procedimentos de Ota.' },
  searchPh:      { ja: '例：婚姻届、児童手当、粗大ごみ…', en: 'e.g. marriage, child allowance…', pt: 'ex: casamento, benefício infantil…' },
  searchBtn:     { ja: '検索', en: 'Search', pt: 'Buscar' },
  recentHeading: { ja: 'よく見られている記事', en: 'Popular Articles', pt: 'Artigos Populares' },
  open:          { ja: '受付中', en: 'Open', pt: 'Aberto' },
  upcoming:      { ja: 'まもなく', en: 'Upcoming', pt: 'Em breve' },
  more:          { ja: '詳細を見る →', en: 'Read more →', pt: 'Leia mais →' },
  seeAll:        { ja: 'すべての記事を見る →', en: 'View All Articles →', pt: 'Ver Todos →' },
  catHeading:    { ja: 'カテゴリから探す', en: 'Browse by Category', pt: 'Explorar por Categoria' },
  troubleHeading:{ ja: '困りごとから探す', en: 'Find by Trouble', pt: 'Buscar por Problema' },
  lifeHeading:   { ja: 'ライフイベント', en: 'Life Events', pt: 'Eventos da Vida' },
  mapHeading:    { ja: '🗺 マップ', en: '🗺 Maps', pt: '🗺 Mapas' },
  mapViewBtn:    { ja: 'マップを見る →', en: 'View Map →', pt: 'Ver Mapa →' },
  steps:         { ja: 'ステップ', en: 'steps', pt: 'passos' },
  statItems:     { ja: '件の手続き', en: 'Procedures', pt: 'Procedimentos' },
  statCats:      { ja: 'カテゴリ', en: 'Categories', pt: 'Categorias' },
  statLangs:     { ja: '言語対応', en: 'Languages', pt: 'Idiomas' },
};
const L = (k: keyof typeof labels) => (labels[k] as any)[lang] ?? (labels[k] as any)['ja'];

// マップレイヤー分の件数をビルド時に取得
const mapIconEmoji: Record<string, string> = {
  wifi: '📶', medical: '🏥', pharmacy: '💊', mobile: '📱',
};
const mapLayers = Object.entries(layerConfig as any).map(([key, cfg]: [string, any]) => {
  const geojsonPath = new URL(
    `../../../public/data/maps/ota_${key}.geojson`,
    import.meta.url
  ).pathname.replace(/^\/([A-Za-z]:)/, '$1'); // Windows パス修正
  let count = 0;
  try {
    const raw = fs.readFileSync(geojsonPath, 'utf-8');
    const gj = JSON.parse(raw);
    count = gj.features?.length ?? 0;
  } catch { /* GeoJSONがなければ 0 */ }
  return {
    key,
    title: cfg.title?.[lang] ?? cfg.title?.ja ?? key,
    icon: cfg.icon,
    count,
  };
});

// 検索インデックス生成（ビルド時）
const searchIndex = allItems
  .filter(i => i.data.status === 'active')
  .map(i => {
    const loc = i.data.locales[lang] ?? i.data.locales['ja'];
    const catMeta = CATEGORY_META[i.data.category as Category];
    return {
      id: i.data.id,
      t: loc.title,
      b: loc.bottom_line ?? '',
      c: (catMeta as any)?.[lang] ?? i.data.category,
      ci: catMeta?.icon ?? '',
      m: i.data.municipality,
    };
  });
---

<LightLayout
  title={lang === 'ja' ? '太田市くらしガイド' : lang === 'en' ? 'Ota City Living Guide' : 'Guia de Vida de Ota'}
  description={lang === 'ja' ? '太田市の行政情報をAIがわかりやすく解説。補助金・届出・保険・子育て情報を日本語・英語・ポルトガル語で。' : 'AI-powered guide to Ota City services.'}
  lang={lang}
  municipality={MUNICIPALITY}
>
  <!-- ① ヒーロー（コンパクト版） -->
  <section class="hero">
    <div class="hero__eyebrow">
      {L('eyebrow')}
    </div>
    <h1 class="hero__h1">
      {L('h1a')}<br>
      <span class="hero__h1-gradient">{L('h1b')}</span>
    </h1>
    <p class="hero__sub">{L('sub')}</p>

    <!-- 検索バー -->
    <div class="hero__search-wrap">
      <div class="hero__search">
        <input
          type="search"
          placeholder={`🔍　${L('searchPh')}`}
          class="hero__search-input"
          id="hero-search"
          autocomplete="off"
        />
        <button
          type="button"
          class="hero__search-btn"
          id="hero-search-btn"
        >{L('searchBtn')}</button>
      </div>
      <div class="search-dropdown" id="search-dropdown" hidden></div>
    </div>
  </section>

  <!-- ② タブ切り替えナビ（カテゴリ・困りごと・ライフイベント） -->
  <section class="home-section--sm">
    <div class="browse-tabs" id="browse-tabs">
      <button class="browse-tab active" data-tab="cat">{L('catHeading')}</button>
      <button class="browse-tab" data-tab="trouble">{L('troubleHeading')}</button>
      <button class="browse-tab" data-tab="life">{L('lifeHeading')}</button>
      <button class="browse-tab" data-tab="map">{L('mapHeading')}</button>
    </div>

    <!-- カテゴリ -->
    <div class="browse-panel active" id="panel-cat">
      <div class="category-grid">
        {CATEGORIES.map(catKey => {
          const meta = CATEGORY_META[catKey];
          return (
            <a class="category-tile" href={`/${lang}/${MUNICIPALITY}/category/${catKey}/`}>
              <span class="category-tile__icon">{meta.icon}</span>
              <span class="category-tile__label">{(meta as any)[lang] ?? meta.ja}</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- 困りごと -->
    <div class="browse-panel" id="panel-trouble">
      <div class="category-grid">
        {DOMAINS.map(domKey => {
          const meta = DOMAIN_META[domKey];
          return (
            <a class="category-tile" href={`/${lang}/${MUNICIPALITY}/troubles/${domKey}/`}>
              <span class="category-tile__icon">{meta.icon}</span>
              <span class="category-tile__label">{(meta as any)[lang] ?? meta.ja}</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- ライフイベント -->
    <div class="browse-panel" id="panel-life">
      <div class="category-grid">
        {journeys.map((j: any) => {
          const locale = j.locales?.[lang] ?? j.locales?.['ja'];
          return (
            <a class="category-tile" href={`/${lang}/${MUNICIPALITY}/journey/${j.id}/`}>
              <span class="category-tile__icon">{j.emoji}</span>
              <span class="category-tile__label">{locale?.trigger ?? j.id}</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- 🗺 マップタブ -->
    <div class="browse-panel" id="panel-map">
      <div class="category-grid">
        {mapLayers.map((lyr) => (
          <a class="category-tile" href={`/${lang}/${MUNICIPALITY}/map/${lyr.key}/`}>
            <span class="category-tile__icon">{mapIconEmoji[lyr.icon] ?? '🗺'}</span>
            <span class="category-tile__label">{lyr.title}</span>
            {lyr.count > 0 && (
              <span style="font-size:var(--text-xs);color:var(--text-muted);margin-top:-.25rem">
                {lyr.count}件
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑤ よく見られている記事（2列グリッド） -->
  <section class="home-section--sm">
    <div class="section-title home-section-title">{L('recentHeading')}</div>
    <div class="article-grid">
      {recent.map(item => {
        const locale = item.data.locales[lang] ?? item.data.locales['ja'];
        const catMeta = CATEGORY_META[item.data.category as Category];
        return (
          <a class="card card--link" href={`/${lang}/${item.data.municipality}/item/${item.data.id}/`}>
            <div class="article-card">
              <div class="article-card__meta">
                {item.data.status === 'active' && <span class="badge badge--active">{L('open')}</span>}
                {item.data.status === 'upcoming' && <span class="badge badge--upcoming">{L('upcoming')}</span>}
                <span class="badge badge--cat">{catMeta?.icon} {(catMeta as any)?.[lang] ?? item.data.category}</span>
              </div>
              <div class="article-card__title">{locale.title}</div>
              <div class="article-card__summary">{locale.bottom_line}</div>
              <div class="article-card__arrow">{L('more')}</div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="home-more-action">
      <a
        href={`/${lang}/${MUNICIPALITY}/`}
        class="btn-outline"
      >
        {L('seeAll')}
      </a>
    </div>
  </section>

  <!-- ③ 統計バナー -->
  <div class="stats-banner">
    <div class="stats-banner__item">
      <div class="stats-banner__number">{allItems.length}</div>
      <div class="stats-banner__label">{L('statItems')}</div>
    </div>
    <div class="stats-banner__item">
      <div class="stats-banner__number">{CATEGORIES.length}</div>
      <div class="stats-banner__label">{L('statCats')}</div>
    </div>
    <div class="stats-banner__item">
      <div class="stats-banner__number">3</div>
      <div class="stats-banner__label">{L('statLangs')}</div>
    </div>
  </div>

  <script is:inline define:vars={{ searchIndex, lang }}>
    // ─── タブ切り替え ───
    document.getElementById('browse-tabs')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.browse-tab');
      if (!btn) return;
      const tab = btn.dataset.tab;
      document.querySelectorAll('.browse-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.browse-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('panel-' + tab)?.classList.add('active');
    });

    // ─── オートコンプリート検索 ───
    (function() {
      const input = document.getElementById('hero-search');
      const btn = document.getElementById('hero-search-btn');
      const dropdown = document.getElementById('search-dropdown');
      if (!input || !btn || !dropdown) return;

      const noResultText = { ja: '該当する記事がありません', en: 'No matching articles', pt: 'Nenhum artigo encontrado' };
      let activeIdx = -1;
      let currentResults = [];

      function normalize(s) {
        return s.toLowerCase()
          .replace(/[\u30A1-\u30F6]/g, function(ch) {
            return String.fromCharCode(ch.charCodeAt(0) - 0x60);
          });
      }

      function search(query) {
        if (query.length < 2) return [];
        const q = normalize(query);
        return searchIndex.filter(function(item) {
          return normalize(item.t).includes(q) || normalize(item.b).includes(q);
        }).slice(0, 8);
      }

      function render(results) {
        activeIdx = -1;
        currentResults = results;
        if (results.length === 0 && input.value.length >= 2) {
          dropdown.innerHTML = '<div class="search-dropdown__empty">' + (noResultText[lang] || noResultText.ja) + '</div>';
          dropdown.hidden = false;
          return;
        }
        if (results.length === 0) {
          dropdown.hidden = true;
          dropdown.innerHTML = '';
          return;
        }
        dropdown.innerHTML = results.map(function(item, i) {
          var href = '/' + lang + '/' + item.m + '/item/' + item.id + '/';
          return '<a class="search-dropdown__item" href="' + href + '" data-idx="' + i + '">' +
            '<span class="search-dropdown__icon">' + item.ci + '</span>' +
            '<span class="search-dropdown__body">' +
              '<span class="search-dropdown__title">' + item.t + '</span>' +
              '<span class="search-dropdown__cat">' + item.c + '</span>' +
            '</span>' +
          '</a>';
        }).join('');
        dropdown.hidden = false;
      }

      function setActive(idx) {
        var items = dropdown.querySelectorAll('.search-dropdown__item');
        items.forEach(function(el) { el.classList.remove('search-dropdown__item--active'); });
        if (idx >= 0 && idx < items.length) {
          items[idx].classList.add('search-dropdown__item--active');
          items[idx].scrollIntoView({ block: 'nearest' });
        }
        activeIdx = idx;
      }

      function navigateToFirst() {
        if (currentResults.length > 0) {
          var target = activeIdx >= 0 ? activeIdx : 0;
          var item = currentResults[target];
          window.location.href = '/' + lang + '/' + item.m + '/item/' + item.id + '/';
        }
      }

      input.addEventListener('input', function() {
        render(search(input.value.trim()));
      });

      input.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          dropdown.hidden = true;
          return;
        }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentResults.length > 0) setActive(Math.min(activeIdx + 1, currentResults.length - 1));
          return;
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentResults.length > 0) setActive(Math.max(activeIdx - 1, 0));
          return;
        }
        if (e.key === 'Enter') {
          e.preventDefault();
          navigateToFirst();
        }
      });

      btn.addEventListener('click', navigateToFirst);

      // 外側クリックでドロップダウン閉じる
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.hero__search-wrap')) {
          dropdown.hidden = true;
        }
      });

      // フォーカス時に再表示
      input.addEventListener('focus', function() {
        if (input.value.trim().length >= 2) {
          render(search(input.value.trim()));
        }
      });
    })();
  </script>

  <!-- WebSite JSON-LD（SEO用 - サイト名認識） -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": lang === 'ja' ? 'くらしガイド' : 'Kurashi Guide',
    "alternateName": lang === 'ja' ? 'Kurashi Guide' : 'くらしガイド',
    "url": "https://kurashiguide.org/",
    "inLanguage": ["ja", "en", "pt"],
    "description": lang === 'ja'
      ? '日本で暮らす外国人のための、多言語行政情報ガイド'
      : lang === 'en'
      ? 'A multilingual guide to government services in Japan'
      : 'Guia multilíngue de serviços governamentais no Japão',
    "publisher": {
      "@type": "Organization",
      "name": "Kurashi Guide",
    },
  })} />

</LightLayout>
